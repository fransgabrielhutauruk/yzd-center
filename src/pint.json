{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": false,
        "not_operator_with_successor_space": false,
        "concat_space": {
            "spacing": "one"
        },
        "phpdoc_align": {
            "align": "left"
        },
        "binary_operator_spaces": {
            "operators": {
                "=>": "align_single_space_minimal"
            }
        },
        "fully_qualified_strict_types": false,
        "single_quote": false
    }
}